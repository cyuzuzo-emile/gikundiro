# Rayon Sports FC - Environment Variables
# Copy this file to .env and fill in your values

# MySQL Connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=rayonsportsfc

# JWT Secret Key (generate a random string, e.g., use openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_here

# Node Environment
NODE_ENV=production

# Server Port
PORT=5000

# Allowed Origins (comma-separated for production, e.g., https://your-frontend.onrender.com)
ALLOWED_ORIGINS=https://your-frontend.onrender.com
